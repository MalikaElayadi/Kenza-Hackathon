{
  "name": "kenza",
  "version": "1.0.0",
  "description": "Kenza - AI Agent Commercial pour E-commerce Marocain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker-compose -f docker-compose.yml up --build",
    "up": "docker-compose up -d",
    "down": "docker-compose down",
    "logs": "docker-compose logs -f",
    "seed": "docker-compose exec api npm run seed",
    "test": "docker-compose exec api npm run test",
    "replay": "tsx scripts/replay-conversations.ts",
    "clean": "docker-compose down -v && rm -rf postgres_data redis_data"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@langchain/langgraph": "^0.1.0",
    "@langchain/core": "^0.1.0",
    "@langchain/openai": "^0.0.1",
    "fastify": "^4.25.0",
    "@fastify/websocket": "^10.0.0",
    "@fastify/cors": "^8.5.0",
    "pg": "^8.11.0",
      "redis": "^5.8.2",
    "bullmq": "^5.0.0",
    "zod": "^3.22.0",
    "csv-parse": "^5.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3",
    "tsx": "^4.6.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
