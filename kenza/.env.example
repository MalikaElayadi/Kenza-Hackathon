# ━━━ LLM CONFIGURATION ━━━
# GPT-5.5 + embeddings — raisonnement & RAG
LLM_URL=https://copilot-19.openai.azure.com/openai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-5.5
EMBEDDING_MODEL=embedder-small-3
EMBEDDING_DIMENSIONS=512

# GPT-4.1 — tâches courantes à fort volume
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://copilot-20.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=16384

# ━━━ DATABASE ━━━
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kenza
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kenza

# ━━━ REDIS ━━━
REDIS_URL=redis://redis:6379

# ━━━ API ━━━
API_PORT=3001
WEB_PORT=3000

# ━━━ WORKER ━━━
WORKER_ENABLED=true
DEMO_DELAY_MINUTES=1440

# ━━━ NODE ━━━
NODE_ENV=development
